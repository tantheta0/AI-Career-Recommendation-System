    {
      "parameters": {
        "jsCode": "// Step 1: Get the raw text from Gemini\nlet rawText = items[0].json.content.parts[0].text || \"\";\n\n// Step 2: Remove the triple backticks and \"json\" if present\nrawText = rawText.replace(/```json\\s*|```/g, \"\");\n\n// Step 3: Parse the JSON string\nlet parsed = {};\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  console.error(\"Failed to parse Gemini JSON:\", e);\n}\n\n// Step 4: Return the fields safely\nreturn [{\n  json: {\n    career_recommendations: parsed.career_recommendations || [],\n    skill_gaps: parsed.skill_gaps || [],\n    next_steps: parsed.next_steps || []\n  }\n}];\n\n\n\n\n\n\n"
      },
